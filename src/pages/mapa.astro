---
import { withBase } from '../lib/paths';
import Layout from '../layouts/Layout.astro';
import { getCatalog } from '../lib/catalog';
import { createMapPoints } from '../lib/map';
import { safeJson } from '../lib/json';
const { destinations } = await getCatalog();
const points = createMapPoints(destinations);
---

<Layout
  title="Explora Panamá en el mapa"
  description="Ubica destinos con coordenadas verificadas y consulta sus fichas. Mapa y lista accesible de lugares documentados."
>
  <section class="container page-top">
    <p class="eyebrow">OTRA FORMA DE EXPLORAR</p>
    <h1 id="map-title">Elige tu próximo rumbo.</h1>
    <p class="lead">
      Cada punto tiene una historia. Solo mostramos lugares con coordenadas documentadas.
    </p>
    <p class="notice">
      Al cargar el mapa se solicitará cartografía a OpenStreetMap, que recibirá tu dirección IP y
      datos técnicos de conexión. No solicitamos tu ubicación.{' '}
      <a href={withBase('/privacidad/')}>Conoce los detalles</a>.
    </p>
    <div class="map-actions">
      <button id="load-map" class="button" hidden>
        Cargar mapa
      </button>
      <a href="#lista-mapa">Ir a la lista de destinos ↓</a>
    </div>
    <p id="map-status" class="map-status" role="status" aria-live="polite">
      {points.length
        ? 'El mapa se carga solo cuando lo solicitas.'
        : 'Todavía no hay coordenadas verificadas para mostrar.'}
    </p>
    <noscript>
      <p class="notice">
        Activa JavaScript para el mapa interactivo. La lista de destinos está disponible a
        continuación.
      </p>
    </noscript>
    <div
      id="map"
      class="map-canvas"
      role="region"
      aria-labelledby="map-title"
      tabindex="0"
      hidden
    ></div>
    <p class="map-attribution">
      Cartografía © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>{' '}
      · <a href="https://www.openstreetmap.org/fixthemap">Informar un error cartográfico</a>
    </p>
    <section class="section-small" id="lista-mapa">
      <h2>Destinos en el mapa</h2>
      <p>Una coordenada de referencia sitúa el destino; no indica necesariamente dónde entrar.</p>
      <ul class="map-list">
        {points.map((p) => (
          <li>
            <a href={withBase(`/destinos/${p.slug}/`)}>{p.name}</a>
            <span>{p.note}</span>
          </li>
        ))}
      </ul>
      {!points.length && <p>No hay marcadores publicados. Puedes consultar el catálogo.</p>}
      <a class="text-link" href={withBase('/explorar/')}>
        Ver todos los destinos, también sin coordenadas ↗︎
      </a>
    </section>
  </section>
  <script id="map-data" type="application/json" is:inline set:html={safeJson(points)} />
  <script>
    import '../scripts/map';
  </script>
</Layout>
